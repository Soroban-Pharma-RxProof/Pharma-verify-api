# Smart Contracts
RXPROOF_CONTRACT_ID=CA2JMBWAT2DDZZHCULUJXWBZ7N27QO2LRADSPNR4CDUULBWIGCJ2CAZO
ADMIN_SECRET_KEY=SC36SAMPLEADMINSECRETKEYFORTESTNETDEPLOYS0000000000000000000
REGULATOR_SECRET_KEY=SC36SAMPLEREGULATORSECRETKEYFORTESTNETDEPLOYS00000000000000000

# Authentication & Security
